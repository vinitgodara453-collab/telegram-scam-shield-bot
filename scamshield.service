[Unit]
Description=AI Scam-Shield & Forensic Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/scam-shield-bot
EnvironmentFile=/root/scam-shield-bot/.env
ExecStart=/usr/bin/python3 /root/scam-shield-bot/scam_shield_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
